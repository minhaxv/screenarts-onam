{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/test-db",
      "destination": "/api/test-db.js"
    },
    {
      "source": "/api/test-supabase",
      "destination": "/api/test-supabase.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
