# Supabase Public Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fallback legacy names
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Backend Secrets (Optional server side only)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/screenarts?retryWrites=true&w=majority
PORT=5000
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

